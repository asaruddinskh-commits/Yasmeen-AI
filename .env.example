# Server & App URL
PORT=3000
APP_URL="http://localhost:3000"

# Gemini AI (Default & Primary Engine)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"

# ElevenLabs Voice API
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM" # e.g. Rachel / customizable

# OpenAI (Optional Alternative Provider)
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic Claude (Optional Alternative Provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Web Search / Serper / Tavily / Google Search Grounding
SEARCH_API_KEY="your_search_api_key_if_applicable"

# Firebase Config (Optional for Auth / Storage sync)
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="your_service_account@project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Storage & Sandboxed Code Execution
STORAGE_PATH="./data/storage"
SANDBOX_EXEC_TIMEOUT_MS=10000
